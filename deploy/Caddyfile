# Caddy reverse proxy for the portfolio.
#
# Both gursimar.xyz and www.gursimar.xyz need DNS A records pointing at this
# EC2 instance's Elastic IP, set to "DNS only" (grey cloud) in Cloudflare so
# Caddy can provision its own Let's Encrypt certificates.
#
# Install to /etc/caddy/Caddyfile, then: sudo systemctl reload caddy

gursimar.xyz {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080
}

# Send www to the bare domain.
www.gursimar.xyz {
	redir https://gursimar.xyz{uri}
}
